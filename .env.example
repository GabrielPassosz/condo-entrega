# Nome exibido no primeiro acesso. Depois, ele fica salvo no banco D1.
CONDOMINIUM_NAME=Residencial Exemplo

# URL HTTPS do serviço da pasta whatsapp-service, sem barra no final.
WHATSAPP_SERVICE_URL=https://seu-servico-whatsapp.exemplo.com

# Use exatamente o mesmo segredo forte configurado no serviço WhatsApp.
WHATSAPP_SERVICE_TOKEN=troque-por-um-segredo-com-pelo-menos-32-caracteres

# URL pública ou privada estável do portal, usada nos cartões de compartilhamento.
SITE_ORIGIN=https://seu-portal.exemplo.com
