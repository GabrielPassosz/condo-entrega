# Bootstrap seguro: sem esta allowlist, ninguém toma posse de um banco vazio.
# Depois do primeiro acesso, convide os demais administradores pela interface.
INITIAL_ADMIN_EMAILS=responsavel@exemplo.com
CONDOMINIUM_NAME=Residencial Exemplo

# Segredo independente usado em AES-GCM e HMAC para os códigos de retirada.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PICKUP_CODE_SECRET=troque-por-64-caracteres-hexadecimais-aleatorios

# WhatsApp Business Platform oficial (Meta Cloud API).
WHATSAPP_PROVIDER=cloud_api
WHATSAPP_CLOUD_API_TOKEN=configure-como-segredo-na-hospedagem
WHATSAPP_PHONE_NUMBER_ID=000000000000000
# Informe explicitamente uma versão ainda suportada pela Meta, por exemplo vXX.X.
WHATSAPP_GRAPH_API_VERSION=vXX.X
WHATSAPP_TEMPLATE_NAME=encomenda_recebida
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_REQUEST_TIMEOUT_MS=10000

# Validação do webhook oficial em /api/webhooks/whatsapp.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=gere-outro-segredo-com-pelo-menos-16-caracteres
WHATSAPP_APP_SECRET=segredo-do-aplicativo-meta

# Origem HTTPS estável usada nos metadados públicos do portal.
SITE_ORIGIN=https://seu-portal.exemplo.com

# Migração temporária apenas. A integração não oficial fica desabilitada por
# padrão e só funciona quando as duas opções abaixo são explícitas.
# WHATSAPP_PROVIDER=baileys
# ALLOW_LEGACY_BAILEYS=true
# WHATSAPP_SERVICE_URL=https://servico-legado.exemplo.com
# WHATSAPP_SERVICE_TOKEN=troque-por-um-segredo-com-pelo-menos-32-caracteres
